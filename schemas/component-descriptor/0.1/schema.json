{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayang.ai/schemas/component-descriptor-0.1.json",
  "title": "Wayang Core Component Descriptor (proposed)",
  "description": "Experimental interchange shape for the Core model. Not the serialization of legacy Wayang classes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "kind", "displayName", "execution"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
    "version": { "$ref": "#/$defs/semver" },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
    "configurationSchemaRef": { "type": "string", "minLength": 1 },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportedModes", "stateModel", "payloadPortable", "cancellationSupported", "idempotent"],
      "properties": {
        "supportedModes": { "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["EMBEDDED", "ISOLATED_LOCAL", "REMOTE", "CLOUD_NATIVE"] } },
        "stateModel": { "enum": ["STATELESS", "EXTERNALIZED", "AFFINE"] },
        "payloadPortable": { "type": "boolean" },
        "cancellationSupported": { "type": "boolean" },
        "idempotent": { "type": "boolean" }
      }
    },
    "metadata": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9.-]*:[a-zA-Z0-9._-]+$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "schemaRef", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "schemaRef": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "description": { "type": "string" }
      }
    }
  }
}
