{
  "apiVersion": "1.0",
  "kind": "AgentPackage",
  "metadata": {
    "id": "acme:crm-assistant",
    "version": "2.1.0",
    "publisher": "acme:publisher",
    "displayName": "CRM Assistant",
    "license": "Commercial",
    "tags": ["crm", "sales"]
  },
  "spec": {
    "agentApiRange": "^1.0",
    "runtimeCompatibility": ">=0.4.0 <1.0.0",
    "agent": {
      "id": "crm-assistant",
      "model": "openai/gpt-4o",
      "systemPrompt": "Help sales representatives retrieve and summarize CRM information.",
      "tools": [
        {
          "name": "crm_lookup",
          "type": "mcp",
          "description": "Look up CRM records.",
          "config": {
            "connectionRef": "crm-production"
          }
        }
      ],
      "maxSteps": 12,
      "timeoutSeconds": 300,
      "requireApproval": [],
      "outputKeys": ["summary"]
    },
    "interface": {
      "inputSchema": {
        "type": "object",
        "required": ["customerId"],
        "properties": { "customerId": { "type": "string" } }
      },
      "outputSchema": {
        "type": "object",
        "required": ["summary"],
        "properties": { "summary": { "type": "string" } }
      }
    },
    "triggers": ["chat", "api", "event"],
    "dependencies": [
      {
        "id": "acme:crm-connector",
        "versionRange": "^2.0",
        "kind": "extension",
        "optional": false
      },
      {
        "id": "acme:sales-tone",
        "versionRange": "~1.3",
        "kind": "skill",
        "optional": true
      }
    ],
    "configuration": [
      {
        "id": "crm-production",
        "displayName": "CRM connection",
        "description": "Select an administrator-approved CRM connection.",
        "kind": "connection-reference",
        "required": true
      },
      {
        "id": "crm-api-token",
        "displayName": "CRM API token",
        "kind": "secret-reference",
        "required": true
      }
    ],
    "requestedPermissions": ["network:crm.example.com", "secret:crm-api-token"],
    "evaluation": {
      "requiredBeforePublish": true,
      "suites": [
        {
          "path": "evaluations/crm-assistant.yaml",
          "mediaType": "application/yaml",
          "role": "agent-evaluation-suite"
        }
      ]
    },
    "resources": [
      {
        "path": "README.md",
        "mediaType": "text/markdown",
        "role": "documentation"
      }
    ]
  }
}