{
  "apiVersion": "1.0",
  "kind": "AgentPackage",
  "metadata": {
    "id": "acme:support-triage",
    "version": "1.0.0",
    "publisher": "acme:publisher",
    "displayName": "Customer Support Triage",
    "description": "Classifies incoming support requests and prepares a suggested response.",
    "license": "Apache-2.0",
    "tags": ["customer-support", "triage"]
  },
  "spec": {
    "agentApiRange": "^1.0",
    "runtimeCompatibility": ">=0.0.1 <1.0.0",
    "agent": {
      "id": "support-triage",
      "name": "Support Triage",
      "model": "openai/gpt-4o",
      "systemPrompt": "Classify the request and prepare a concise response.",
      "inputTemplate": "Ticket: {{ ticket.text }}",
      "maxSteps": 8,
      "timeoutSeconds": 180,
      "tools": [],
      "requireApproval": [],
      "outputKeys": ["category", "suggestedReply"]
    },
    "interface": {
      "inputSchema": {
        "type": "object",
        "required": ["ticket"],
        "properties": {
          "ticket": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": { "type": "string" }
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": ["category", "suggestedReply"],
        "properties": {
          "category": { "type": "string" },
          "suggestedReply": { "type": "string" }
        }
      }
    },
    "triggers": ["chat", "api"],
    "dependencies": [],
    "configuration": [],
    "requestedPermissions": []
  }
}