{
  "apiVersion": "1.0",
  "kind": "Plugin",
  "metadata": {
    "id": "acme.csv-suite",
    "version": "2.0.0-rc.1",
    "publisher": "Acme",
    "license": "Apache-2.0"
  },
  "spec": {
    "runtimeCompatibility": ">=0.0.1 <1.0.0",
    "provides": {
      "components": [
        { "id": "acme.csv-reader", "version": "2.1.0" },
        { "id": "acme.csv-writer", "version": "2.0.0" }
      ]
    },
    "dependencies": [
      { "id": "acme.shared-schema", "versionRange": "^1.4.0", "optional": true }
    ],
    "permissions": ["filesystem:read", "filesystem:write"]
  }
}
