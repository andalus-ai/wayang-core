{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wayang.ai/schemas/plugin-manifest-1.0.json",
  "title": "Wayang Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "kind": { "const": "Plugin" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "publisher"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
        "version": { "$ref": "#/$defs/semver" },
        "publisher": { "type": "string", "minLength": 1 },
        "license": { "type": "string" }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeCompatibility", "provides"],
      "properties": {
        "runtimeCompatibility": { "type": "string", "minLength": 1 },
        "provides": {
          "type": "object",
          "additionalProperties": false,
          "required": ["components"],
          "properties": {
            "components": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "version"],
                "properties": {
                  "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
                  "version": { "$ref": "#/$defs/semver" }
                }
              }
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "versionRange"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
              "versionRange": { "type": "string", "minLength": 1 },
              "optional": { "type": "boolean", "default": false }
            }
          }
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z0-9._*-]+$" }
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    }
  }
}
